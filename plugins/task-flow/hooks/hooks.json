{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--quiet", "--script", "${CLAUDE_PLUGIN_ROOT}/scripts/guard.py"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
