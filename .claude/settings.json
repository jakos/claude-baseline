{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "claude-baseline-dev": {
      "source": {
        "source": "directory",
        "path": "."
      }
    }
  },
  "enabledPlugins": {
    "dev-baseline@claude-baseline-dev": true,
    "dev-baseline@claude-baseline": false
  },
  "permissions": {
    "allow": [
      "Bash(claude plugin validate:*)",
      "Bash(git diff:*)",
      "Bash(git status)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(claude plugin eval:*)"
    ]
  }
}
